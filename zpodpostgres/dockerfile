FROM postgres:15.19-trixie

COPY /zpodpostgres/db-create.sql /docker-entrypoint-initdb.d/

# Runs on every start. When the data volume was created under an older base
# image (different glibc => different collation version), it reindexes and
# refreshes the collation version of every database before Postgres accepts
# client connections. No-op when the versions already match.
COPY /zpodpostgres/entrypoint.sh /usr/local/bin/zpodpostgres-entrypoint.sh
RUN chmod +x /usr/local/bin/zpodpostgres-entrypoint.sh

ENTRYPOINT ["zpodpostgres-entrypoint.sh"]
