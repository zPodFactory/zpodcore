# Copy this file to .env and fill in the values for your zPodFactory
# instance. .env is gitignored - never commit real tokens.
#
# The suite reads only this file, never an existing zcli factory config on
# the host. README.md covers running it.

# --- Required ---

# Base URL of the zPodFactory API you're testing against.
E2E_API_BASE_URL=http://zpodfactory.example.com:8000

# A superadmin API token on that server. This grants full access (create
# users, settings, endpoints, everything) - treat it like any other secret.
# Get one via: zcli user reset_api_token <your-superadmin-username>
E2E_SUPERADMIN_TOKEN=

# Name of a pre-existing, already-registered, ACTIVE vCenter/NSX endpoint
# to deploy test zPods against. The suite does not create endpoints itself.
E2E_ENDPOINT_NAME=

# --- Component library testing ---

# Every file in this directory is uploaded and synced as part of the
# component-upload test. Point this at a folder of real component installer
# files (OVAs, ISOs, etc.) on the machine running the suite. ~ is expanded.
E2E_DOWNLOAD_SOURCE_DIR=~/downloads

# Must match the live stack's ZPODCORE_PRODUCTS_PATH, so the
# disable-removes-on-disk-directory test can check the right path.
E2E_PRODUCTS_PATH=/zPod/Products

# Broadcom download token. Set: the suite writes it to the server's
# zpodfactory_broadcom_download_token (and leaves it there), proves it with a
# real vcfinstaller-9.1.1.0 download (2.3 GB), and puts it back after the
# no-token test. Empty: only the no-token test runs, and it skips if the
# server already has a token (the API never returns it, so it couldn't be
# put back).
E2E_BROADCOM_TOKEN=

# --- DNS ---

# Resolver to query when verifying zPod/component DNS records actually
# resolve (not just that the API says they exist).
E2E_DNS_RESOLVER=

# --- On-host verification (SSH into the test zPods) ---

# Private key matching the server's zpodfactory_ssh_key setting: every zPod VM
# gets that public key, and the suite logs in with BatchMode (no password
# fallback). The appliance generates ~/.ssh/id_rsa for root at first boot and
# stores its public half in the setting, so the default works when the suite
# runs on the appliance itself. Checked once at session start.
E2E_ZPOD_SSH_KEY=~/.ssh/id_rsa

# zcore image for the shared zPod of the network/storage modules. Needs
# zboxapi >= 0.2.1 (zcore-13.7 or later).
E2E_ZCORE_COMPONENT_UID=zcore-13.7
# Regular addable component (component add/remove, the VM on a user VLAN).
E2E_ZBOX_COMPONENT_UID=zbox-13.7.1

# --- zPod networks (VLANs on zcore) ---

# Two user VLANs the network module adds and removes. Pick subnets outside
# the endpoint's zPod pool and anything routed in your lab.
E2E_USER_VLAN=111
E2E_USER_VLAN_GATEWAY=10.42.111.1/24
E2E_SECOND_VLAN=112
E2E_SECOND_VLAN_GATEWAY=10.42.112.1/24

# A URL a VM on a user VLAN can reach only with masquerade on.
E2E_INTERNET_PROBE_URL=https://github.com

# true: add a network as global (advertised into the NSX fabric), check zcore
# answers on it from here, then withdraw and remove it. false: only the dry-run.
# The machine running the suite must route to the fabric.
E2E_FABRIC_ROUTING=false
E2E_GLOBAL_VLAN=113
# Empty: 192.168.<x>.1/24, x = third octet of the test zPod's range.
E2E_GLOBAL_VLAN_GATEWAY=

# --- Component options (opt-in, heavier) ---

# A profile on the server whose zPods have a vCenter, for the nested
# placement test (zbox nested on VM Network). Empty: the test deploys its own
# from tests/fixtures/profiles/base9.json.
E2E_NESTED_PROFILE=

# --- OVA staging comparison ---
# The ff_endpoint_ova_staging test deploys the suite's zcore-only profile with
# staging off then on and shows the deploy time of each component in the
# report. List more profiles (names on your server, comma separated) to
# compare them too; each one costs two full deploys, one at a time.
E2E_OVA_STAGING_PROFILES=
# An extraConfig (guestinfo.*) image to deploy and log into, e.g.
# photon-5.0 or ubuntu-24.04. Empty: skipped.
E2E_EXTRACONFIG_COMPONENT_UID=

# --- Resource naming & cleanup ---

# Prefix used for every resource this suite creates (zpods, users, profiles,
# zcli factories). Also what the cleanup sweep matches on.
E2E_RESOURCE_PREFIX=e2e-

# Set to 1 to disable teardown after a run, so you can inspect a failure by
# hand. Remember to run `just cleanup` manually afterward.
E2E_KEEP_RESOURCES=0

# Zpods that reached DEPLOY_FAILED/DESTROY_FAILED are left in place by
# default (even with E2E_KEEP_RESOURCES=0) so you can inspect the actual
# broken VM/vCenter state, not just the error message. Successful (ACTIVE)
# zpods are still cleaned up normally either way. Set to 0 to fully
# auto-clean, including failures. Remember to run `just cleanup` by hand
# once you're done inspecting a kept-back failure.
E2E_KEEP_FAILED_RESOURCES=1

# --- Prefect diagnostics ---

E2E_PREFECT_UI_URL=http://zpodfactory.example.com:8060
E2E_PREFECT_API_URL=http://zpodfactory.example.com:8060/api

# --- Timeouts & concurrency ---

# Bump this for heavier profiles - a plain zcore deploy takes ~2 minutes,
# but a profile chaining vcsa/nsx can take close to an hour.
E2E_DEPLOY_TIMEOUT_SECONDS=2400
# Per-zPod timeout for the slow concurrency batch (`just concurrency-slow`):
# three vcd-prod replicas deployed side by side take ~55 minutes each.
E2E_SLOW_DEPLOY_TIMEOUT_SECONDS=7200
E2E_COMPONENT_DOWNLOAD_TIMEOUT_SECONDS=3600
E2E_POLL_INTERVAL_SECONDS=10
E2E_CONCURRENCY_MAX_WORKERS=15
